<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="36dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/logo_circle">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flow_fab"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/permBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp"
            android:padding="14dp"
            android:background="@drawable/bg_banner_warn"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/permBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="Erişilebilirlik kapalı — oto-senkron çalışmaz" />

            <TextView
                android:id="@+id/permBannerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_enable"
                android:textColor="#FFB300"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:paddingStart="14dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/pickSrt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:text="@string/pick_srt"
            android:textColor="#2E7CF6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:id="@+id/srtInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/srt_none"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/recent_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/settings_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/idle_opacity"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/opacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="end"
                android:textColor="#2E7CF6"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Hidden" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/seekOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:value="40"
            app:labelBehavior="gone"
            app:thumbColor="#2E7CF6"
            app:trackColorActive="#2E7CF6"
            app:trackColorInactive="#33FFFFFF"
            app:haloColor="#332E7CF6"
            app:tickVisible="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fade_delay"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fadeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="end"
                android:textColor="#2E7CF6"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="4 s" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/seekFade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="20"
            android:stepSize="1"
            android:value="4"
            app:labelBehavior="gone"
            app:thumbColor="#2E7CF6"
            app:trackColorActive="#2E7CF6"
            app:trackColorInactive="#33FFFFFF"
            app:haloColor="#332E7CF6"
            app:tickVisible="false" />

        <Button
            android:id="@+id/startOverlay"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:text="@string/start_overlay"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            android:outlineProvider="background"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
